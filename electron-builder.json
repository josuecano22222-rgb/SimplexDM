{
  "appId": "com.meridian.viewer",
  "productName": "SimplexDM",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron-main.js",
    "preload.js",
    "public/**/*",
    "server/**/*",
    "scripts/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "target": ["dmg", "zip"]
  },
  "linux": {
    "target": ["AppImage", "deb", "rpm"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
