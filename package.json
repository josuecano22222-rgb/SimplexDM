{
  "name": "SimplexDM",
  "version": "2.0.0",
  "description": "Professional desktop application for viewing, analyzing, and managing 3D Tiles (Cesium 3D Tiles) data",
  "main": "electron-main.js",
  "scripts": {
    "predev": "node scripts/ensure-electron.js --required && node scripts/rebuild-native.js --electron",
    "dev": "cross-env NODE_ENV=development electron .",
    "preelectron": "node scripts/ensure-electron.js --required && node scripts/rebuild-native.js --electron",
    "electron": "electron .",
    "preelectron:dev": "node scripts/ensure-electron.js --required && node scripts/rebuild-native.js --electron",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "prewebpack": "node scripts/emit-locale.mjs",
    "build:brand": "node scripts/export-brand-assets.mjs",
    "webpack": "npm run build:brand && node scripts/generate-webpack-entry.js && webpack --mode production",
    "webpack:dev": "node scripts/generate-webpack-entry.js && webpack --mode development",
    "prepare:electron": "node scripts/ensure-electron.js --required && node scripts/rebuild-native.js --electron",
    "prebuild": "npm run webpack && npm run prepare:electron",
    "build": "electron-builder",
    "build:win": "npm run webpack && npm run prepare:electron && electron-builder --win",
    "build:mac": "npm run webpack && npm run prepare:electron && electron-builder --mac",
    "build:linux": "npm run webpack && npm run prepare:electron && electron-builder --linux",
    "build:all": "npm run webpack && npm run prepare:electron && electron-builder --win --mac --linux",
    "build:win-portable": "npm run webpack && npm run prepare:electron && electron-builder --win portable",
    "package": "npm run webpack && npm run prepare:electron && electron-builder",
    "package:all": "npm run webpack && npm run prepare:electron && electron-builder --win --mac --linux",
    "prestart": "node scripts/rebuild-native.js --quiet",
    "start": "node server/server.js",
    "start:server": "node server/server.js",
    "build:toolbar-icons": "node public/Style/build-toolbar-icons.mjs",
    "i18n:emit": "node scripts/emit-locale.mjs",
    "i18n:check": "node scripts/emit-locale.mjs --check",
    "labels:build": "node scripts/offlineLabelTools.js build-labels",
    "labels:pack": "node scripts/offlineLabelTools.js pack-region",
    "tiles:meta": "node scripts/offlineLabelTools.js update-meta",
    "seed:labels": "node -e \"const {findPython3,runPythonScript}=require('./scripts/offlineLabelTools');const py=findPython3();if(!py){console.error('Python 3.8+ is required for seed_world_labels.py (note: data/labels-world-base.db is already pre-built).');process.exit(1);}runPythonScript(py,'scripts/seed_world_labels.py',process.argv.slice(1),{stdio:'inherit'});\" --",
    "seed:samples": "node scripts/generate-sample-tileset.mjs",
    "setup": "node scripts/setup.js --copy-cesium",
    "setup:cesium": "node scripts/setup.js --copy-cesium",
    "setup:electron": "node scripts/ensure-electron.js --required",
    "rebuild": "node scripts/rebuild-native.js",
    "rebuild:electron": "node scripts/rebuild-native.js --electron",
    "rebuild:source": "node scripts/rebuild-native.js --electron --from-source",
    "postinstall": "node scripts/setup.js && node scripts/ensure-electron.js && node scripts/rebuild-native.js",
    "pretest": "node scripts/rebuild-native.js --quiet",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "pretest:coverage": "node scripts/rebuild-native.js --quiet",
    "test:coverage": "jest --coverage --passWithNoTests",
    "pretest:unit": "node scripts/rebuild-native.js --quiet",
    "test:unit": "jest tests/unit",
    "pretest:integration": "node scripts/rebuild-native.js --quiet",
    "test:integration": "jest tests/integration"
  },
  "keywords": [
    "3d-tiles",
    "cesium",
    "geospatial",
    "visualization",
    "electron",
    "desktop",
    "3d",
    "tileset",
    "b3dm",
    "i3dm",
    "pnts",
    "cmpt"
  ],
  "author": "SimplexDM Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/josuecano22222-rgb/SimplexDM.git"
  },
  "bugs": {
    "url": "https://github.com/josuecano22222-rgb/SimplexDM/issues"
  },
  "homepage": "https://github.com/josuecano22222-rgb/SimplexDM#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "electron": true,
    "electron-winstaller": true,
    "fsevents": true,
    "protobufjs": false
  },
  "overrides": {
    "better-sqlite3": "$better-sqlite3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.2",
    "@electron/rebuild": "^4.0.3",
    "@jest/globals": "^29.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "electron": "^40.0.0",
    "electron-builder": "^26.6.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.meridian.viewer",
    "productName": "SimplexDM",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron-main.js",
      "main/**/*",
      "preload.js",
      "public-bundled/**/*",
      "server/**/*",
      "scripts/**/*",
      "data/**/*",
      "package.json",
      "!public/**/*",
      "!webpack-entry.js",
      "!data/tiles/raster/**/*",
      "!data/tiles/raster.zip",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "main/gis/workers/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/rtree-sql.js/dist/**/*",
      "node_modules/jsts/dist/**/*"
    ],
    "extraFiles": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*",
          "!tiles/raster/**/*",
          "!tiles/raster.zip"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SimplexDM",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": false,
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "@ngageoint/geopackage": "^4.2.5",
    "@tmcw/togeojson": "^7.1.2",
    "better-sqlite3": "^12.8.0",
    "cesium": "^1.137.0",
    "epsg-index": "^2.0.0",
    "geotiff": "^3.0.5",
    "jsts": "^2.12.1",
    "papaparse": "^5.5.3",
    "proj4": "^2.20.4",
    "shapefile": "^0.6.6",
    "unzipper": "^0.12.3",
    "xlsx": "^0.18.5",
    "xmldom": "^0.6.0"
  }
}
